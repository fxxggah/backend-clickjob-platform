<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Versão do modelo de POM do Maven (padrão 4.0.0) -->
    <modelVersion>4.0.0</modelVersion>

    <!-- Projeto Pai: Herda configurações de dependências e plugins padrão do Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/> <!-- Busca o parent diretamente do repositório remoto -->
    </parent>

    <!-- Identificação do Projeto -->
    <groupId>com.freelance</groupId> <!-- Pacote principal do projeto -->
    <artifactId>freelance-platform</artifactId> <!-- Nome do executável/artefato gerado -->
    <version>0.0.1-SNAPSHOT</version> <!-- Versão atual do projeto (SNAPSHOT = em desenvolvimento) -->
    <name>ClickJob Platform</name> <!-- Nome amigável da aplicação -->
    <description>Sistema para Freelancers</description> <!-- Descrição curta do sistema -->

    <!-- Seções de metadados do projeto (licença, desenvolvedores, repositório de código) -->
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <!-- Propriedades do Projeto -->
    <properties>
        <!-- Define a versão do Java utilizada no projeto -->
        <java.version>17</java.version>
    </properties>

    <!-- Dependências do Projeto (Bibliotecas externas) -->
    <dependencies>
        <!-- Spring Data JPA: Facilita a integração com banco de dados usando ORM/Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Security: Módulo de autenticação, autorização e controle de acesso -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring Validation: Suporte a validações de formulários/DTOs (ex: @NotNull, @Email, @Size) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Web MVC: Suporte para criação de APIs REST e aplicações web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI / Swagger UI: Gera a documentação interativa da API REST -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- Driver JDBC do MySQL: Permite a conexão com o banco de dados MySQL em tempo de execução -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok: Biblioteca que reduz código boilerplate (gera getters, setters, constructors dinamicamente) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Dependências para Testes Automatizados -->
        <!-- Testes para a camada de persistência/banco de dados -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testes para as configurações e regras de segurança -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testes para validações de dados -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testes para controladores e rotas web (MVC/REST) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JWT (JSON Web Token): Bibliotecas para manipulação e validação de tokens de autenticação -->
        <!-- Interface de programação (API) do JJWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <!-- Implementação interna das funcionalidades do JJWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <!-- Suporte do JJWT para serialização/deserialização de JSON usando Jackson -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Anotações JetBrains: Fornece anotações como @NotNull e @Nullable para auxílio da IDE -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.1.0</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <!-- Configurações de Compilação e Build -->
    <build>
        <plugins>
            <!-- Plugin de Compilação Java: Configurado para processar as anotações do Lombok durante o build -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Plugin do Spring Boot: Permite empacotar o projeto como um JAR executável e rodar via Maven -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Exclui o Lombok do arquivo JAR final, pois ele só é necessário em tempo de compilação -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>